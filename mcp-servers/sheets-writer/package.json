{
  "name": "@pdwkend/sheets-writer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server writing itinerary rows into an existing spreadsheet via Sheets API v4.",
  "main": "./dist/server.js",
  "bin": {
    "sheets-writer-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdwkend/contracts": "*",
    "googleapis": "^175.0.0",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./src/*.js": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  }
}
