{
  "name": "@pdwkend/flight-fares-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing live, fee-inclusive flight fares.",
  "main": "./dist/server.js",
  "bin": {
    "flight-fares-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdwkend/contracts": "*",
    "zod": "^4.4.3",
    "@pdwkend/sources": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./src/*.js": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  }
}
