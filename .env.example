# Copy to .env and fill in. Never commit the real file — .gitignore covers it.

# ── Google Sheets ────────────────────────────────────────────────────────────
# Path to a service-account key JSON. Create one at
# console.cloud.google.com → IAM & Admin → Service Accounts → Keys → Add key,
# enable the Google Sheets API for the same project, then share your spreadsheet
# with the service account's email (the client_email in this file) as an Editor.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/pdwkend-service-account.json

# Alternative for environments where a file path is awkward — the key's contents
# inline. Takes precedence over the path above.
# PDWKEND_SA_KEY_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# The spreadsheet you want itineraries written into: the segment of its URL
# between /d/ and /edit. Not read by the servers — the agent passes it per call —
# but a handy place to keep it.
# PDWKEND_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ── Fare scraping ────────────────────────────────────────────────────────────
# Per-navigation timeout for the headless browser, in ms.
# PDWKEND_NAV_TIMEOUT_MS=45000

# Set to 1 to watch the browser work — useful when a site changes and an
# adapter starts failing.
# PDWKEND_HEADFUL=0
